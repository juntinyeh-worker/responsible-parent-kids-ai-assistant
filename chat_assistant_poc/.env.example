# OpenAI API key for local development
OPENAI_API_KEY=sk-your-key-here

# Environment: "local" or "aws"
DEPLOY_ENV=local

# Optional: Override the realtime model name (leave empty for auto-detection)
# Options: gpt-realtime (GA), gpt-4o-realtime-preview (beta)
OPENAI_REALTIME_MODEL=

# AWS settings (Phase 2 — ECS deployment)
# S3_LOG_BUCKET=my-conversation-logs-bucket
# S3_LOG_PREFIX=conversation-logs
# SECRETS_NAME=openai-api-key
