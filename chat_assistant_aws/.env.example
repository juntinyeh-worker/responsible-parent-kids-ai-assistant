# Environment: "local" or "aws"
DEPLOY_ENV=local

# AWS credentials (for local dev — Nova Sonic via Bedrock)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1

# Bedrock / Nova Sonic
BEDROCK_REGION=us-east-1
NOVA_VOICE_ID=matthew

# AWS settings (ECS deployment)
# S3_LOG_BUCKET=my-conversation-logs-bucket
# S3_LOG_PREFIX=conversation-logs
# S3_AUDIO_PREFIX=voice-responses
